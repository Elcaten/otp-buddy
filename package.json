{
  "name": "web-extension-starter",
  "version": "3.0.4",
  "description": "Web extension starter using react and typescript",
  "private": true,
  "repository": "https://github.com/abhijithvijayan/web-extension-starter.git",
  "author": {
    "name": "abhijithvijayan",
    "email": "email@abhijithvijayan.in",
    "url": "https://abhijithvijayan.in"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "dev:chrome": "cross-env TARGET_BROWSER=chrome vite build --config vite.config.ts --mode development --watch",
    "dev:firefox": "cross-env TARGET_BROWSER=firefox vite build --config vite.config.ts --mode development --watch",
    "build:chrome": "cross-env TARGET_BROWSER=chrome vite build --config vite.config.ts",
    "build:firefox": "cross-env TARGET_BROWSER=firefox vite build --config vite.config.ts",
    "build": "npm run build:chrome && npm run build:firefox",
    "generate:email-parser-artifacts": "npm run generate:email-parser-types && npm run generate:email-parser-validator",
    "generate:email-parser-types": "json2ts --input source/email-parser/email-parser-config.schema.json --output source/email-parser/email-parser-config.types.ts --unreachableDefinitions --bannerComment \"/* Generated from email-parser-config.schema.json. Do not edit by hand. */\"",
    "generate:email-parser-validator": "node scripts/generate-email-parser-validator.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:ui:chromium": "playwright test --ui --project=chromium",
    "init:safari": "xcrun safari-web-extension-packager --project-location safari --app-name OTPBuddy --bundle-identifier com.elcaten.otpbuddy ./extension/chrome",
    "prepare": "husky"
  },
  "dependencies": {
    "@sentry/browser": "^10.65.0",
    "@testing-library/dom": "^10.4.1",
    "advanced-css-reset": "^2.1.3",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.12",
    "dotenv": "^17.4.2",
    "install": "^0.13.0",
    "jmap-client-ts": "^1.0.0",
    "jmap-jam": "^0.13.2",
    "lucide-react": "^1.24.0",
    "motion": "^12.42.2",
    "oauth4webapi": "^3.8.6",
    "postal-mime": "^2.7.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-error-boundary": "^6.1.2",
    "runtypes": "^7.0.4",
    "swr": "^2.4.2",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/gapi.client.gmail-v1": "^0.0.4",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/webextension-polyfill": "^0.12.4",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "ajv": "^8.20.0",
    "autoprefixer": "^10.5.2",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "json-schema-to-typescript": "^15.0.4",
    "postcss": "^8.5.18",
    "prettier": "^3.9.5",
    "sass": "^1.101.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.4",
    "vite-plugin-checker": "^0.14.4",
    "vite-plugin-clean": "^2.0.1",
    "vite-plugin-wext-manifest": "^1.2.2",
    "vite-plugin-zip-pack": "^1.2.4",
    "vitest": "^4.1.10"
  }
}
