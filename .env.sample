# Extension build (required)
VITE_OTP_BUDDY_SAFARI_CLIENT_ID=
VITE_OTP_BUDDY_WEB_CLIENT_ID=
VITE_OTP_BUDDY_WEB_CLIENT_SECRET=

# Don't forget to set both GitHub Actions secrets and Dependabot secrets
# so that E2E won't fail for Dependabot.

# --- E2E Test Secrets (CI only) ---
# Tier 2: Tigrmail disposable inbox tests
# TIGRMAIL_TOKEN=                  # API token from https://console.tigrmail.com

# Tier 3: Gmail integration tests
# GMAIL_TESTER_CREDENTIALS_JSON=   # JSON string of gmail-tester credentials.json
# GMAIL_TESTER_TOKEN_JSON=         # JSON string of gmail-tester token.json
# GMAIL_TEST_REFRESH_TOKEN=        # OAuth refresh token for extension Gmail auth
# TEST_EMAIL_GMAIL=

# Tier 4: Nightly real login service tests
# TEST_GITLAB_EMAIL=               # Email registered on GitLab (use Gmail test address)
# TEST_POLYMARKET_EMAIL=           # Email registered on Polymarket (use Gmail test address)
